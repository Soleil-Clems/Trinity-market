# Chemin : .env.example
# =====================================================================
#  DEV — facultatif : cp .env.example .env
#  Toutes les variables ont une valeur par défaut dans .docker/docker-compose.yml.
#  Pour la production, voir .env.prod.example.
# =====================================================================

# Port exposé sur l'hôte par Traefik (seul port public)
PUBLIC_PORT=8080

# PostgreSQL — appliqué à la PREMIÈRE création du volume db-data
POSTGRES_USER=app
POSTGRES_PASSWORD=change_me_dev_password
POSTGRES_DB=app

# Secret JWT de dev (openssl rand -base64 48)
JWT_SECRET=change_me_with_at_least_32_characters
