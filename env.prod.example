# Chemin : .env.prod.example
# =====================================================================
#  PRODUCTION — sur le serveur :  cp .env.prod.example .env
#  Ce fichier ne contient AUCUN secret : les mots de passe et clés sont
#  dans ./secrets/ (générés par scripts/gen-secrets.sh), montés en
#  Docker secrets. Les variables marquées "requis" bloquent le démarrage
#  si elles sont absentes.
# =====================================================================

# --- Images (construites et poussées par la CI) ----------------------
# Registre en minuscules, sans tag. Requis.
REGISTRY=ghcr.io/mon-org/mon-projet
# Version déployée = tag git poussé (ex. v1.4.0). Requis.
APP_VERSION=v1.0.0

# --- Domaine & TLS ---------------------------------------------------
# Nom de domaine public, son DNS (A/AAAA) doit pointer vers ce serveur. Requis.
DOMAIN=app.example.com
# Contact Let's Encrypt (alertes d'expiration). Requis.
ACME_EMAIL=tanguy1.gibrat@epitech.eu
# Pour tester sans consommer le quota Let's Encrypt, utiliser le staging :
# ACME_CA_SERVER=https://acme-staging-v02.api.letsencrypt.org/directory
ACME_CA_SERVER=https://acme-v02.api.letsencrypt.org/directory

# --- PostgreSQL (le mot de passe est dans secrets/db_password.txt) ---
POSTGRES_USER=app
POSTGRES_DB=app

# --- Backend ---------------------------------------------------------
# Niveau de log NestJS (debug/verbose désactivés en prod)
LOG_LEVEL=log
# Migrations (service one-shot `migrate`) : détection automatique.
#   - dossier prisma/ présent → prisma migrate deploy ("prisma" doit être en dependencies)
#   - sinon dist/database/data-source.js présent → typeorm migration:run
# Laisser vide sauf besoin d'une commande spécifique, par exemple :
# MIGRATION_COMMAND=node node_modules/prisma/build/index.js migrate deploy
MIGRATION_COMMAND=

# --- Sauvegardes (scripts/backup-db.sh) -------------------------------
BACKUP_DIR=/var/backups/app
BACKUP_RETENTION_DAYS=14
